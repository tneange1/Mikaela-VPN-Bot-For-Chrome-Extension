# Telegram
TG_TOKEN=123456:ABC...            # токен от @BotFather
ADMIN_IDS=123456789               # ваш Telegram ID (через запятую, если несколько). Остальным бот не отвечает.

# SSH на серверы (отдельный ключ только для бота)
SSH_KEY=/root/.ssh/mikaela_bot
#SSH_KEY_PASSPHRASE=
SSH_USER=root

# GitHub: fine-grained токен, доступ только к Mikaela-VPN-Client, право Contents: Read and write
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=tneange1/Mikaela-VPN-Client
GITHUB_PATH=chrome/servers.json
GITHUB_BRANCH=main

# Общий логин/пароль бесплатного прокси (попадают в публичный servers.json и в расширение!)
PROXY_USER=free
PROXY_PASS=придумайте-длинный-пароль

# Let's Encrypt
LE_EMAIL=you@example.com
# Где на серверах лежат сертификаты (как у вас сейчас)
CERTBOT_BASE=/opt/certbot

# Необязательно
#PORT_RANGE=9443-9499
#PROXY_IMAGE=ghcr.io/xtls/xray-core:latest
#RENEW_DAYS=30
